import Mathlib.Basic.Real.Basic
import Mathlib.RingTheory.MvPolynomial.Homogeneous
import Mathlib.RingTheory.MvPolynomial.Ideal
import Mathlib.Tactic.FinCases
import Mathlib.Tactic.Ring

/-!
# Relations among the three homogeneous coordinates

The kernel of `(b₀,b₁,b₂) ↦ X₀ b₀ + X₁ b₁ + X₂ b₂` is generated by the
three coordinate Koszul relations. Projecting their coefficients onto a
homogeneous component gives the degree-preserving form used in graded
dimension arguments. Every homogeneous polynomial of positive degree also
has a coordinate decomposition with homogeneous coefficients.
-/

namespace PanelMoments.CoordinateSyzygies

open MvPolynomial

noncomputable section

abbrev Poly := MvPolynomial (Fin 3) ℝ

abbrev Homogeneous (n : ℕ) := ↥(homogeneousSubmodule (Fin 3) ℝ n)

/-- Every relation among the coordinates is a combination of the three
pairwise coordinate relations. -/
theorem coordinate_syzygy {b₀ b₁ b₂ : Poly}
    (h : X 0 * b₀ + X 1 * b₁ + X 2 * b₂ = 0) :
    ∃ c₀₁ c₀₂ c₁₂ : Poly,
      b₀ = -X 1 * c₀₁ - X 2 * c₀₂ ∧
      b₁ = X 0 * c₀₁ - X 2 * c₁₂ ∧
      b₂ = X 0 * c₀₂ + X 1 * c₁₂ := by
  classical
  have hb₂_mem : b₂ ∈ Ideal.span (X '' ({0, 1} : Set (Fin 3))) := by
    apply mem_ideal_span_X_image.mpr
    intro m hm
    by_cases hm₀ : m 0 ≠ 0
    · exact ⟨0, by simp, hm₀⟩
    by_cases hm₁ : m 1 ≠ 0
    · exact ⟨1, by simp, hm₁⟩
    have hm₀' : m 0 = 0 := not_ne_iff.mp hm₀
    have hm₁' : m 1 = 0 := not_ne_iff.mp hm₁
    exfalso
    apply mem_support_iff.mp hm
    have hc := congrArg
      (fun p : Poly => p.coeff (Finsupp.single 2 1 + m)) h
    have hc₀ : (X 0 * b₀).coeff (Finsupp.single 2 1 + m) = 0 := by
      simp [coeff_X_mul', Finsupp.mem_support_iff, hm₀']
    have hc₁ : (X 1 * b₁).coeff (Finsupp.single 2 1 + m) = 0 := by
      simp [coeff_X_mul', Finsupp.mem_support_iff, hm₁']
    simpa only [AddMonoidAlgebra.coeff_add, AddMonoidAlgebra.coeff_zero,
      Finsupp.add_apply, Finsupp.zero_apply, hc₀, hc₁, coeff_X_mul, zero_add] using hc
  have hb₂_pair : b₂ ∈ Ideal.span ({(X 0 : Poly), X 1} : Set Poly) := by
    simpa only [Set.image_pair] using hb₂_mem
  obtain ⟨c₀₂, c₁₂, hc₂⟩ := Ideal.mem_span_pair.mp hb₂_pair
  have hb₂ : b₂ = X 0 * c₀₂ + X 1 * c₁₂ := by
    simpa only [mul_comm] using hc₂.symm
  have hpair :
      X 0 * (b₀ + X 2 * c₀₂) + X 1 * (b₁ + X 2 * c₁₂) = 0 := by
    calc
      X 0 * (b₀ + X 2 * c₀₂) + X 1 * (b₁ + X 2 * c₁₂) =
          X 0 * b₀ + X 1 * b₁ + X 2 * b₂ := by rw [hb₂]; ring
      _ = 0 := h
  have hdiv : (X 0 : Poly) ∣ X 1 * (b₁ + X 2 * c₁₂) := by
    refine ⟨-(b₀ + X 2 * c₀₂), ?_⟩
    calc
      X 1 * (b₁ + X 2 * c₁₂) = -(X 0 * (b₀ + X 2 * c₀₂)) :=
        eq_neg_of_add_eq_zero_right hpair
      _ = X 0 * -(b₀ + X 2 * c₀₂) := by ring
  have hdiv' : (X 0 : Poly) ∣ b₁ + X 2 * c₁₂ :=
    (X_dvd_mul_iff.mp hdiv).resolve_left (by simp)
  obtain ⟨c₀₁, hc₁⟩ := hdiv'
  have hb₁ : b₁ = X 0 * c₀₁ - X 2 * c₁₂ :=
    eq_sub_iff_add_eq.mpr hc₁
  have hb₀ : b₀ = -X 1 * c₀₁ - X 2 * c₀₂ := by
    apply (X_mul_cancel_left_iff (i := (0 : Fin 3))).mp
    calc
      X 0 * b₀ = -(X 1 * b₁ + X 2 * b₂) :=
        eq_neg_of_add_eq_zero_left (by simpa only [add_assoc] using h)
      _ = X 0 * (-X 1 * c₀₁ - X 2 * c₀₂) := by rw [hb₁, hb₂]; ring
  exact ⟨c₀₁, c₀₂, c₁₂, hb₀, hb₁, hb₂⟩

/-- Multiplication by a coordinate shifts homogeneous components by one. -/
theorem homogeneousComponent_X_mul_succ (n : ℕ) (i : Fin 3) (p : Poly) :
    homogeneousComponent (n + 1) (X i * p) =
      X i * homogeneousComponent n p := by
  classical
  ext m
  by_cases hi : i ∈ m.support
  · have hle : Finsupp.single i 1 ≤ m := by
      rw [Finsupp.single_le_iff]
      exact Nat.one_le_iff_ne_zero.mpr (Finsupp.mem_support_iff.mp hi)
    obtain ⟨m', rfl⟩ : ∃ m', m = Finsupp.single i 1 + m' :=
      ⟨m - Finsupp.single i 1, (add_tsub_cancel_of_le hle).symm⟩
    have hdegree : 1 + m'.degree = n + 1 ↔ m'.degree = n := by
      constructor
      · intro hd
        exact Nat.succ.inj ((Nat.add_comm 1 m'.degree).symm.trans hd)
      · intro hd
        rw [hd, Nat.add_comm]
    simp [coeff_homogeneousComponent, hdegree]
  · simp [coeff_homogeneousComponent, coeff_X_mul', hi]

/-- The map `(b₀,b₁,b₂) ↦ X₀ b₀ + X₁ b₁ + X₂ b₂` from degree `n`
coefficients onto homogeneous polynomials of degree `n + 1` is surjective. -/
theorem coordinate_decomposition_homogeneous {n : ℕ} {f : Poly}
    (hf : f.IsHomogeneous (n + 1)) :
    ∃ b₀ b₁ b₂ : Poly,
      b₀.IsHomogeneous n ∧ b₁.IsHomogeneous n ∧ b₂.IsHomogeneous n ∧
      f = X 0 * b₀ + X 1 * b₁ + X 2 * b₂ := by
  classical
  have hf_mem : f ∈ Ideal.span (X '' (Set.univ : Set (Fin 3))) := by
    apply mem_ideal_span_X_image.mpr
    intro m hm
    have hdegree : m.degree = n + 1 := by
      rw [Finsupp.degree_eq_weight_one]
      exact hf (mem_support_iff.mp hm)
    have hm_ne : m ≠ 0 := by
      intro hm_zero
      simp [hm_zero] at hdegree
    obtain ⟨i, hi⟩ := Finsupp.support_nonempty_iff.mpr hm_ne
    exact ⟨i, Set.mem_univ _, Finsupp.mem_support_iff.mp hi⟩
  have hindices : (Set.univ : Set (Fin 3)) = {0, 1, 2} := by
    ext i
    fin_cases i <;> simp
  have hf_three : f ∈ Ideal.span ({(X 0 : Poly), X 1, X 2} : Set Poly) := by
    simpa [hindices] using hf_mem
  obtain ⟨a₀, g, hg, hf₀⟩ := Ideal.mem_span_insert.mp hf_three
  obtain ⟨a₁, a₂, hg'⟩ := Ideal.mem_span_pair.mp hg
  have hf_eq : f = X 0 * a₀ + X 1 * a₁ + X 2 * a₂ := by
    rw [hf₀, ← hg']
    ring
  refine ⟨homogeneousComponent n a₀, homogeneousComponent n a₁,
    homogeneousComponent n a₂, homogeneousComponent_isHomogeneous _ _,
    homogeneousComponent_isHomogeneous _ _, homogeneousComponent_isHomogeneous _ _, ?_⟩
  have hc := congrArg (homogeneousComponent (n + 1)) hf_eq
  simpa only [homogeneousComponent_eq_self hf, map_add,
    homogeneousComponent_X_mul_succ] using hc

/-- The coordinate map between consecutive homogeneous degrees. -/
def coordinateLinearMap (n : ℕ) :
    (Fin 3 → Homogeneous n) →ₗ[ℝ] Homogeneous (n + 1) where
  toFun b := ⟨X 0 * (b 0 : Poly) + X 1 * (b 1 : Poly) + X 2 * (b 2 : Poly), by
    change (X 0 * (b 0 : Poly) + X 1 * (b 1 : Poly) +
      X 2 * (b 2 : Poly)).IsHomogeneous (n + 1)
    have h := (((isHomogeneous_X ℝ (0 : Fin 3)).mul (b 0).property).add
      ((isHomogeneous_X ℝ (1 : Fin 3)).mul (b 1).property)).add
      ((isHomogeneous_X ℝ (2 : Fin 3)).mul (b 2).property)
    simpa only [Nat.add_comm] using h⟩
  map_add' := by
    intro b c
    apply Subtype.ext
    change X 0 * ((b 0 : Poly) + (c 0 : Poly)) +
        X 1 * ((b 1 : Poly) + (c 1 : Poly)) +
        X 2 * ((b 2 : Poly) + (c 2 : Poly)) =
      (X 0 * (b 0 : Poly) + X 1 * (b 1 : Poly) + X 2 * (b 2 : Poly)) +
        (X 0 * (c 0 : Poly) + X 1 * (c 1 : Poly) + X 2 * (c 2 : Poly))
    ring
  map_smul' := by
    intro a b
    apply Subtype.ext
    change X 0 * (a • (b 0 : Poly)) + X 1 * (a • (b 1 : Poly)) +
        X 2 * (a • (b 2 : Poly)) =
      a • (X 0 * (b 0 : Poly) + X 1 * (b 1 : Poly) + X 2 * (b 2 : Poly))
    simp only [smul_add, mul_smul_comm]

@[simp]
theorem coordinateLinearMap_apply (n : ℕ) (b : Fin 3 → Homogeneous n) :
    (coordinateLinearMap n b : Poly) =
      X 0 * (b 0 : Poly) + X 1 * (b 1 : Poly) + X 2 * (b 2 : Poly) := rfl

theorem coordinateLinearMap_surjective (n : ℕ) :
    Function.Surjective (coordinateLinearMap n) := by
  intro f
  obtain ⟨b₀, b₁, b₂, h₀, h₁, h₂, hf⟩ :=
    coordinate_decomposition_homogeneous f.property
  let b : Fin 3 → Homogeneous n :=
    Fin.cases ⟨b₀, h₀⟩ (Fin.cases ⟨b₁, h₁⟩ (fun _ => ⟨b₂, h₂⟩))
  refine ⟨b, ?_⟩
  apply Subtype.ext
  change X 0 * b₀ + X 1 * b₁ + X 2 * b₂ = (f : Poly)
  exact hf.symm

/-- A homogeneous coordinate relation has homogeneous Koszul coefficients
of degree one less than its components. -/
theorem coordinate_syzygy_homogeneous {n : ℕ} {b₀ b₁ b₂ : Poly}
    (h₀ : b₀.IsHomogeneous (n + 1))
    (h₁ : b₁.IsHomogeneous (n + 1))
    (h₂ : b₂.IsHomogeneous (n + 1))
    (h : X 0 * b₀ + X 1 * b₁ + X 2 * b₂ = 0) :
    ∃ c₀₁ c₀₂ c₁₂ : Poly,
      c₀₁.IsHomogeneous n ∧ c₀₂.IsHomogeneous n ∧ c₁₂.IsHomogeneous n ∧
      b₀ = -X 1 * c₀₁ - X 2 * c₀₂ ∧
      b₁ = X 0 * c₀₁ - X 2 * c₁₂ ∧
      b₂ = X 0 * c₀₂ + X 1 * c₁₂ := by
  obtain ⟨c₀₁, c₀₂, c₁₂, hb₀, hb₁, hb₂⟩ := coordinate_syzygy h
  refine ⟨homogeneousComponent n c₀₁, homogeneousComponent n c₀₂,
    homogeneousComponent n c₁₂, homogeneousComponent_isHomogeneous _ _,
    homogeneousComponent_isHomogeneous _ _, homogeneousComponent_isHomogeneous _ _,
    ?_, ?_, ?_⟩
  · have hc := congrArg (homogeneousComponent (n + 1)) hb₀
    simpa only [homogeneousComponent_eq_self h₀, neg_mul, map_sub, map_neg,
      homogeneousComponent_X_mul_succ] using hc
  · have hc := congrArg (homogeneousComponent (n + 1)) hb₁
    simpa only [homogeneousComponent_eq_self h₁, map_sub,
      homogeneousComponent_X_mul_succ] using hc
  · have hc := congrArg (homogeneousComponent (n + 1)) hb₂
    simpa only [homogeneousComponent_eq_self h₂, map_add,
      homogeneousComponent_X_mul_succ] using hc

end

end PanelMoments.CoordinateSyzygies

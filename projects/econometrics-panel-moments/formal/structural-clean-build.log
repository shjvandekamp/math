PanelMoments.StructuralCompleteness.three_choice_generic_moment_dimension (T : ℕ) (hT : 1 ≤ T) :
  (PanelMoments.StructuralGenericity.genericRegion T).Nonempty ∧
    IsOpen (PanelMoments.StructuralGenericity.genericRegion T) ∧
      Dense (PanelMoments.StructuralGenericity.genericRegion T) ∧
        ∀ θ ∈ PanelMoments.StructuralGenericity.genericRegion T,
          ∀ (r : PanelMoments.State 2),
            Module.finrank ℝ ↥(PanelMoments.momentSubmodule (PanelMoments.EconomicFamily.parameterTable θ) T r) =
              3 ^ T + 6 * (T - 1) - (3 * T).choose 2
PanelMoments.StructuralCompleteness.economic_moment_dimension_add_choose {T : ℕ} (hT : 1 ≤ T)
  {θ : PanelMoments.EconomicFamily.EconomicParameter T} (hθ : θ ∈ PanelMoments.StructuralGenericity.genericRegion T)
  (r : PanelMoments.State 2) :
  Module.finrank ℝ ↥(PanelMoments.momentSubmodule (PanelMoments.EconomicFamily.parameterTable θ) T r) +
      (3 * T).choose 2 =
    3 ^ T + 6 * (T - 1)
PanelMoments.StructuralCompleteness.four_period_moment_dimension {θ : PanelMoments.EconomicFamily.EconomicParameter 4}
  (hθ : θ ∈ PanelMoments.StructuralGenericity.genericRegion 4) (r : PanelMoments.State 2) :
  Module.finrank ℝ ↥(PanelMoments.momentSubmodule (PanelMoments.EconomicFamily.parameterTable θ) 4 r) = 33
